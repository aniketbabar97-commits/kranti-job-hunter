# Copy this file to me.env (same folder) and put in your real phone and email.
# me.env stays on this laptop; it is never uploaded to GitHub.
CANDIDATE_PHONE=+49 ...
CANDIDATE_EMAIL=you@example.com
# 1 = submit by itself when the form is complete (no CAPTCHA, no empty required field); 0 = you click Submit
AUTO_SUBMIT=1
# Gmail app password (same one the hunter uses) so the helper can read verification codes/links from portals
KRANTI_GMAIL_APP_PASSWORD=
# One password for all job-portal accounts the helper creates (Workday, SuccessFactors). Empty = random per site.
ACCOUNT_PASSWORD=
# Any long random sentence. Encrypts helper/vault.enc (the account store). Never change it afterwards.
VAULT_KEY=
# AI answers for free-text / motivation questions (Gemini first, Groq second; same keys as the hunter). Empty = such questions are parked.
GEMINI_API_KEY=
GROQ_API_KEY=
# Street + house number and postcode (some forms require a full address; stays on this PC)
CANDIDATE_STREET=
CANDIDATE_POSTCODE=
